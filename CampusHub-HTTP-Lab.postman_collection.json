{
  "info": {
    "_postman_id": "5a422ea0-5039-4f63-a18c-8f5ad2f0c817",
    "name": "CampusHub — HTTP Lab",
    "description": "8 запитів: 5 позитивних і 3 негативних. Запускайте колекцію послідовно; змінна eventId встановлюється після POST, а тестова подія видаляється після DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "01 POSITIVE — GET filtered events (query)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "url": { "raw": "{{baseUrl}}/api/events-from-file?date=2026-10-15", "host": ["{{baseUrl}}"], "path": ["api", "events-from-file"], "query": [{ "key": "date", "value": "2026-10-15" }] },
        "description": "Очікується: 200, Content-Type application/json, body — масив подій з date=2026-10-15. Демонструє query і custom header."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "pm.test('Body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));" ] } }]
    },
    {
      "name": "02 POSITIVE — POST create event (JSON body)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"HTTP Lab test event\",\n  \"date\": \"2026-12-01\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/events-from-file", "host": ["{{baseUrl}}"], "path": ["api", "events-from-file"] },
        "description": "Очікується: 201, Content-Type application/json, body містить id, title і date. id автоматично зберігається у змінну eventId."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "const body = pm.response.json();", "pm.test('Created body has expected fields', () => { pm.expect(body.id).to.be.a('string'); pm.expect(body.title).to.eql('HTTP Lab test event'); pm.expect(body.date).to.eql('2026-12-01'); });", "pm.collectionVariables.set('eventId', body.id);" ] } }]
    },
    {
      "name": "03 POSITIVE — PUT replace event (path + JSON body)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"HTTP Lab updated by PUT\",\n  \"date\": \"2026-12-02\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/events-from-file/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events-from-file", "{{eventId}}"] },
        "description": "Очікується: 200, Content-Type application/json, body — повністю замінена подія. Демонструє path parameter."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "pm.test('Body is replaced event', () => pm.expect(pm.response.json().title).to.eql('HTTP Lab updated by PUT'));" ] } }]
    },
    {
      "name": "04 POSITIVE — PATCH event title",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"HTTP Lab updated by PATCH\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/events-from-file/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events-from-file", "{{eventId}}"] },
        "description": "Очікується: 200, Content-Type application/json, body з оновленим title та збереженим date."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "pm.test('Only requested field is changed', () => { const body = pm.response.json(); pm.expect(body.title).to.eql('HTTP Lab updated by PATCH'); pm.expect(body.date).to.eql('2026-12-02'); });" ] } }]
    },
    {
      "name": "05 POSITIVE — DELETE test event",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "url": { "raw": "{{baseUrl}}/api/events-from-file/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events-from-file", "{{eventId}}"] },
        "description": "Очікується: 204, Content-Type відсутній, body порожній. Прибирає тестові дані."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 204', () => pm.response.to.have.status(204));", "pm.test('Content-Type is absent for 204', () => pm.expect(pm.response.headers.get('Content-Type')).to.be.null);", "pm.test('Body is empty', () => pm.expect(pm.response.text()).to.eql(''));" ] } }]
    },
    {
      "name": "06 NEGATIVE — POST invalid JSON fields",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/events-from-file", "host": ["{{baseUrl}}"], "path": ["api", "events-from-file"] },
        "description": "Очікується: 400, Content-Type application/json, body.message про невалідні title/date."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));", "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "pm.test('Error body has message', () => pm.expect(pm.response.json().message).to.be.a('string'));" ] } }]
    },
    {
      "name": "07 NEGATIVE — PATCH missing event",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"No such event\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/events-from-file/not-found-id", "host": ["{{baseUrl}}"], "path": ["api", "events-from-file", "not-found-id"] },
        "description": "Очікується: 404, Content-Type application/json, body.message про відсутню подію."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));", "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "pm.test('Error body has message', () => pm.expect(pm.response.json().message).to.be.a('string'));" ] } }]
    },
    {
      "name": "08 NEGATIVE — GET unknown route",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Lab-Student", "value": "CampusHub-HTTP-Lab" }],
        "url": { "raw": "{{baseUrl}}/api/unknown-route", "host": ["{{baseUrl}}"], "path": ["api", "unknown-route"] },
        "description": "Очікується: 404, Content-Type application/json, body.message про відсутній маршрут."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));", "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "pm.test('Error body has message', () => pm.expect(pm.response.json().message).to.be.a('string'));" ] } }]
    }
  ]
}
